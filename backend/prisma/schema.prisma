datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  code  String  @id
  name  String
  spec  String
  price Decimal @db.Decimal(12, 2)
  stock Decimal @db.Decimal(12, 2)
}

model Vendor {
  code String @id
  name String
}

model PurchaseHeader {
  id         Int            @id @default(autoincrement())
  billNo     String         @unique
  vendorCode String
  vendorName String
  total      Decimal        @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  lines      PurchaseLine[]
}

model PurchaseLine {
  id          Int            @id @default(autoincrement())
  headerId    Int
  lineNo      Int
  productCode String
  productName String
  qty         Decimal        @db.Decimal(12, 2)
  price       Decimal        @db.Decimal(12, 2)
  amount      Decimal        @db.Decimal(12, 2)
  header      PurchaseHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
}
